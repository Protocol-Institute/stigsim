# Port used by the Vite development and preview servers.
PORT=3000

# URL prefix for assets. Use "/" for local development or root deployments.
BASE_PATH=/

# Leave blank locally to use Vite's /api proxy. Set this in the GitHub Pages
# build to the public Railway origin, without a trailing slash.
VITE_INFINITE_SERVER_URL=

# Server-only production settings (configure these as Railway secrets).
# DATABASE_URL=postgresql://...
# ALLOWED_ORIGINS=https://stigsim.protocol-institute.org
