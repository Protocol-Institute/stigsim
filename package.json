{
  "name": "stigsim",
  "version": "1.0.0",
  "description": "A browser-based stigmergy simulator for exploring how ant colonies solve mazes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "pnpm --dir server dev",
    "build": "tsc --noEmit && vite build && node scripts/prepare-static-routes.mjs",
    "test": "pnpm typecheck && pnpm test:routes && pnpm test:coverage && pnpm test:server",
    "test:routes": "tsx --test src/routes.test.ts",
    "test:client": "tsx --test packages/sim-core/src/*.test.ts packages/sim-trace/src/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude=\"**/node_modules/**\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"**/fixtures/**\" --test-coverage-exclude=\"packages/sim-core/src/types.ts\" --test-coverage-lines=95 --test-coverage-branches=92 --test-coverage-functions=97 packages/sim-core/src/*.test.ts packages/sim-trace/src/*.test.ts",
    "golden": "tsx packages/sim-trace/src/fixtures/make-golden.ts",
    "test:persistence": "pnpm --dir server exec tsx --test src/sim.persistence.test.ts",
    "test:server": "pnpm --dir server exec tsx --test src/degraded-status.test.ts src/fixed-step.test.ts src/sim.persistence.test.ts src/sim.phero-bookkeeping.test.ts src/sim.starvation.test.ts src/security.test.ts src/transport.test.ts src/ws.integration.test.ts",
    "typecheck": "tsc --noEmit && pnpm --dir packages/sim-core typecheck && pnpm --dir packages/sim-trace typecheck && pnpm --dir server typecheck",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@stigsim/sim-core": "workspace:*",
    "@stigsim/sim-trace": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.16.0"
}
