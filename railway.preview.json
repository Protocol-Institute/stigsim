{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "pnpm install --frozen-lockfile && pnpm build" },
  "deploy": { "numReplicas": 1, "startCommand": "pnpm preview:model-ant", "healthcheckPath": "/api/healthz", "healthcheckTimeout": 100, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3 }
}
